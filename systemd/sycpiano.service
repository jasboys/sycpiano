[Unit]
Description=Sean Chen Piano
After=network.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/srv/sycpiano-prod
Environment=NODE_ENV=production
ExecStart=/bin/bash -lc 'source "$HOME/.nvm/nvm.sh" && nvm use default && yarn start'
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target