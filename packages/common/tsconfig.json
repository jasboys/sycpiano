{
    "compileOnSave": false,
    "compilerOptions": {
        "lib": [
            "ESNext"
        ],
        "module": "NodeNext",
        "target": "ESNext",
        "allowJs": true,
        "moduleResolution": "NodeNext",
        "strict": true,
        "noImplicitAny": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "removeComments": false,
        "preserveConstEnums": true,
        "sourceMap": false,
        "skipLibCheck": true,
        "outDir": "dist",
        "rootDir": "./src",
        "declaration": true
    },
    "exclude": [
        "**/node_modules/*"
    ],
    "include": [
        "./src",
    ]
}