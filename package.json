{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "seanchenpiano",
    "version": "2.2.0",
    "description": "Website Sean Chen Piano",
    "repository": {
        "type": "git",
        "url": "git@github.com:jasboys/sycpiano.git"
    },
    "type": "module",
    "license": "MIT",
    "author": "Sean Chen, Andrew Chen, and Jason Chen",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "dev": "turbo run watch",
        "start": "node packages/server/build/app.js",
        "watch": "nodemon --config nodemon.json packages/server/build/app.js",
        "migrate": "dbmate -d ./packages/server/migrations -s ./schema.sql"
    },
    "os": [
        "linux",
        "win32"
    ],
    "packageManager": "yarn@4.11.0",
    "engines": {
        "node": ">=24.0.0"
    },
    "dependencies": {
        "cross-env": "^10.1.0",
        "markdown-to-jsx": "^9.9.0",
        "turbo": "^2.8.14",
        "typescript": "^5.9.3"
    },
    "devDependencies": {
        "@biomejs/biome": "2.4.6",
        "@biomejs/cli-linux-x64": "2.4.6",
        "@biomejs/cli-win32-x64": "2.4.6",
        "nodemon": "^3.1.14"
    },
    "resolutions": {
        "minimatch@npm:3.1.2/brace-expansion": "^1.1.12",
        "minimatch@npm:5.1.6/brace-expansion": "^2.0.2",
        "jsondiffpatch": "^0.7.2",
        "jws": "^4.0.1",
        "tar": "^7.5.10",
        "lodash": "^4.17.23",
        "express/qs": "^6.14.2",
        "body-parser/qs": "^6.14.2",
        "schema-utils/ajv": "^8.18.0",
        "axios": "^1.13.5",
        "@tanstack/react-query": "^5.90.21",
        "minimatch@npm:^10.2.1": "^10.2.3",
        "minimatch@npm:^9.0.4": "^9.0.7",
        "minimatch@npm:^3.1.1": "^3.1.4",
        "minimatch@npm:^5.1.0": "^5.1.8",
        "immutable@npm:^4.3.4": "^4.3.8",
        "dompurify@npm:^3.2.4": "^3.3.2",
        "react-admin/react-hook-form": "^7.71.2",
        "react-hook-form@npm:*": "^7.71.2"
    }
}
