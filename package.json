{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "seanchenpiano",
    "version": "2.2.0",
    "description": "Website Sean Chen Piano",
    "repository": {
        "type": "git",
        "url": "git@github.com:jasboys/sycpiano.git"
    },
    "type": "module",
    "license": "MIT",
    "author": "Sean Chen, Andrew Chen, and Jason Chen",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "dev": "turbo run watch",
        "start": "node packages/server/build/app.js",
        "watch": "nodemon --config nodemon.json packages/server/build/app.js",
        "migrate": "dbmate -d ./packages/server/migrations -s ./schema.sql"
    },
    "os": [
        "linux",
        "win32"
    ],
    "packageManager": "yarn@4.18.0",
    "engines": {
        "node": "24.x"
    },
    "dependencies": {
        "cross-env": "^10.1.0",
        "typescript": "6"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.13",
        "@biomejs/cli-linux-x64": "2.5.13",
        "@biomejs/cli-win32-x64": "2.5.13",
        "nodemon": "^3.1.14",
        "turbo": "^2.10.13"
    },
    "resolutions": {
        "jsondiffpatch": "^0.7.2",
        "jws": "^4.0.1",
        "tar": "^7.5.10",
        "express/qs": "^6.14.2",
        "body-parser/qs": "^6.14.2",
        "schema-utils/ajv": "^8.18.0",
        "minimatch@npm:^10.2.4": "^10.2.6",
        "minimatch@npm:^5.1.0": "^5.1.8",
        "ra-core/react-router": "^7.18.4",
        "ra-core/react-router-dom": "^7.18.4",
        "react-admin/react-router": "^7.18.4",
        "react-admin/react-router-dom": "^7.18.4",
        "react-admin/react-hook-form": "^7.71.2",
        "react-hook-form@npm:*": "^7.71.2",
        "@tootallnate/once@npm:2": "^2.0.1"
    }
}
