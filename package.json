{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "seanchenpiano",
    "version": "2.2.0",
    "description": "Website Sean Chen Piano",
    "repository": {
        "type": "git",
        "url": "git@github.com:jasboys/sycpiano.git"
    },
    "type": "module",
    "license": "MIT",
    "author": "Sean Chen, Andrew Chen, and Jason Chen",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "dev": "turbo run watch",
        "start": "node packages/server/build/app.js",
        "watch": "nodemon --config nodemon.json packages/server/build/app.js",
        "migrate": "dbmate -d ./packages/server/migrations -s ./schema.sql"
    },
    "os": [
        "linux",
        "win32"
    ],
    "packageManager": "yarn@4.18.0",
    "engines": {
        "node": "24.x"
    },
    "dependencies": {
        "cross-env": "^10.1.0",
        "typescript": "6.0.3"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.15",
        "@biomejs/cli-linux-x64": "2.5.15",
        "@biomejs/cli-win32-x64": "2.5.15",
        "nodemon": "^3.1.14",
        "turbo": "^2.11.6"
    },
    "resolutions": {
        "jsondiffpatch": "^0.7.6",
        "jws": "^4.0.1",
        "tar": "^7.5.10",
        "qs": "6.16.0",
        "yaml": "1.10.3",
        "express/body-parser": "2.3.0",
        "minimatch@^10.2.4": "^10.2.6",
        "minimatch@^5.1.0": "^5.1.8",
        "ra-core/react-router": "^7.18.4",
        "ra-core/react-router-dom": "^7.18.4",
        "react-admin/react-router": "^7.18.4",
        "react-admin/react-router-dom": "^7.18.4",
        "@tootallnate/once@2": "^2.0.1",
        "path-to-regexp": "^8.4.2",
        "brace-expansion@^2.0.2": "^2.1.7",
        "brace-expansion@^1.1.7": "^1.1.21",
        "decode-uri-component": "^0.5.0",
        "picomatch@^2.3.1": "^2.3.2",
        "picomatch@^2.0.4": "^2.3.2",
        "picomatch@^2.2.1": "^2.3.2",
        "browserslist": "^4.29.3"
    }
}
